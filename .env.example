# Backend environment variables
# Load order: .env.[NODE_ENV].local → .env.[NODE_ENV] → .env.local → .env

NODE_ENV=development
PORT=3001

# Frontend URL allowed to call this API (CORS)
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Public backend base URL (no trailing slash)
BASE_URL=http://localhost:3001

# Required — MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.0hdhyvo.mongodb.net/travel_package_builder

# Optional
# SEED_PATH=data/db.json
